{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run && node scripts/style-scan.mjs && node scripts/dialog-scan.mjs",
    "test:watch": "vitest",
    "style:scan": "node scripts/style-scan.mjs",
    "dialog:scan": "node scripts/dialog-scan.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "dompurify": "^3.4.16",
    "element-plus": "^2.14.7",
    "marked": "^18.0.14",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "20.14.5",
    "oxfmt": "0.71.0",
    "oxlint": "^1.86.0",
    "sass": "^1.105.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.25.0"
}
