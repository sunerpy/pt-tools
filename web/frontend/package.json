{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run && node scripts/style-scan.mjs && node scripts/dialog-scan.mjs",
    "test:watch": "vitest",
    "style:scan": "node scripts/style-scan.mjs",
    "dialog:scan": "node scripts/dialog-scan.mjs",
    "build:mobile": "vue-tsc -b && vite build --config vite.mobile.config.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@vueuse/core": "^14.4.0",
    "dompurify": "^3.4.18",
    "element-plus": "^2.14.8",
    "marked": "^18.2.0",
    "modern-screenshot": "4.7.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-element-plus-x": "2.0.3",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "20.14.5",
    "oxfmt": "0.78.0",
    "oxlint": "^1.93.0",
    "sass": "^1.108.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.25.0"
}
